# Copy to .env (git-ignored) and fill in.

# Backend the MCP server reads from.
STUDIO_API_URL=http://127.0.0.1:8000

# Backend account the MCP server logs in as (email/password login, /api/auth/login).
# An owner account sees everything; a staff account gets orders, bookings and
# products only (logins and user actions are owner-only).
STUDIO_EMAIL=
STUDIO_PASSWORD=

# --- HTTP mode only (python server.py http) ---
# Comma-separated keys, 24+ characters each; give each person/client their own
# so you can revoke one without affecting the others. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEYS=
MCP_HOST=127.0.0.1
MCP_PORT=8100
# Public hostname(s) clients connect through, comma-separated, e.g. mcp.example.com.
# Use * when the hostname changes (trycloudflare.com quick tunnels).
MCP_ALLOWED_HOSTS=
